{
  "Input": "./obj/odm_textured_model_geo.obj",
  "Output": "./obj_tiles/",
  "MaxVerticesPerTile": 8000,
  "PackingThreshold": 0.618, // Allowed value for prevent texture resizing. 0.1 - no texture resizing, less packed atlas
  "KeepOriginalTextures": false,
  "KeepIntermediateFiles": false,
  "ThreadsCount": 8,
  "BaseError": 100.0,
  "Latitude": null,
  "Longitude": null,
  "Altitude": 0,
  "Scale": 1,
  "YUpToZUp": false,
  "LODs": [
    {
      "Quality": 1.0,
      "SaveVertexColor": false,
      "SaveUv": true
    },
    {
      "Quality": 0.5,
      "SaveVertexColor": true,
      "SaveUv": false
    },
    {
      "Quality": 0.2,
      "SaveVertexColor": true,
      "SaveUv": false
    }
  ]
}