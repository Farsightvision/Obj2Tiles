<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <RootNamespace>Obj2Tiles.Native</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep the runtimes/<rid>/native/ tree for NuGet packaging. -->
    <None Include="native/runtimes/**/*" Pack="true" PackagePath="runtimes/" CopyToOutputDirectory="PreserveNewest" Link="runtimes/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    For project references (no NuGet packaging), the .NET runtime native-library
    resolver does NOT scan runtimes/<rid>/native/ automatically — that path only
    works for assets advertised in deps.json by NuGet. To make P/Invoke work for
    consumers that pull us in via <ProjectReference>, also copy the host-RID
    native lib next to the consuming assembly.
  -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$(ProcessorArchitecture)' != 'X86' And '$(ProcessorArchitecture)' != 'AMD64'">
    <Content Include="native/runtimes/osx-arm64/native/libmeshoptimizer.dylib"
             Link="libmeshoptimizer.dylib"
             CopyToOutputDirectory="PreserveNewest"
             Pack="false"
             Visible="false" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX')) And ('$(ProcessorArchitecture)' == 'X86' Or '$(ProcessorArchitecture)' == 'AMD64')">
    <Content Include="native/runtimes/osx-x64/native/libmeshoptimizer.dylib"
             Link="libmeshoptimizer.dylib"
             CopyToOutputDirectory="PreserveNewest"
             Pack="false"
             Visible="false"
             Condition="Exists('native/runtimes/osx-x64/native/libmeshoptimizer.dylib')" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <Content Include="native/runtimes/linux-x64/native/libmeshoptimizer.so"
             Link="libmeshoptimizer.so"
             CopyToOutputDirectory="PreserveNewest"
             Pack="false"
             Visible="false"
             Condition="Exists('native/runtimes/linux-x64/native/libmeshoptimizer.so')" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Content Include="native/runtimes/win-x64/native/meshoptimizer.dll"
             Link="meshoptimizer.dll"
             CopyToOutputDirectory="PreserveNewest"
             Pack="false"
             Visible="false"
             Condition="Exists('native/runtimes/win-x64/native/meshoptimizer.dll')" />
  </ItemGroup>
</Project>
